 JSValue JS_ResumeWith(JSContext *ctx, JSValue result, JS_BOOL throw_flag);
+/* Terminate the suspended execution, if any, without running any of
+   its code: the suspended frames are discarded as if the execution
+   could not be resumed (see JS_RequestSuspend()): their 'catch' and
+   'finally' clauses are not executed and their 'using' resources are
+   not disposed, but the closures they created keep working. The
+   runtime accepts a new suspension afterwards. A pending
+   JS_RequestSuspend() request, if any, is left alone. Returns TRUE if
+   a suspended execution was abandoned, FALSE if none was pending. */
+JS_BOOL JS_AbandonSuspended(JSContext *ctx);
 
