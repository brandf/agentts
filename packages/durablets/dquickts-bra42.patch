+/* Terminate the suspended execution, if any, without running any of
+   its code (see JS_AbandonSuspended() in quickjs.h). The suspended
+   frames are released by js_abort_suspended_frames(), the same path a
+   failed resume takes; the pending suspension marker exception is
+   cleared the way JS_ResumeWith() clears it. */
+JS_BOOL JS_AbandonSuspended(JSContext *ctx)
+{
+    JSRuntime *rt = ctx->rt;
+    JSAsyncFunctionState *s = rt->suspended;
+
+    if (!s)
+        return FALSE;
+    rt->suspended = NULL;
+    if (js_is_suspend_marker(rt->current_exception)) {
+        rt->current_exception = JS_UNINITIALIZED;
+        rt->current_exception_is_uncatchable = FALSE;
+    }
+    js_abort_suspended_frames(rt, s);
+    return TRUE;
+}
+
 static JSValue js_call(JSContext *ctx, JSValueConst func_obj,
                        JSValueConst this_obj, int argc, JSValueConst *argv)
