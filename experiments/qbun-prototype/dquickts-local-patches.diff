diff --git a/qbun.c b/qbun.c
index 578bcd7..90894f0 100644
--- a/qbun.c
+++ b/qbun.c
@@ -24,6 +24,58 @@
 
 #include "node/qbun.h"
 
+/*
+ * EXPERIMENT (qbun-prototype): a durable step() builtin for workflows.
+ * step(input) suspends the calling workflow with JS_SuspendCall(); the
+ * host snapshots the runtime, exits, and a fresh process resumes the
+ * call with JS_ResumeWith(). Only the sync-looking style works: a step
+ * called from an async frame throws "TypeError: this call cannot be
+ * suspended". Registered on the main context after bootstrap so the
+ * workflow module can call it as a plain global.
+ */
+static JSValue qb_step(JSContext *ctx, JSValueConst this_val,
+                       int argc, JSValueConst *argv)
+{
+    JSValue json = JS_JSONStringify(ctx, argc > 0 ? argv[0] : JS_UNDEFINED,
+                                    JS_UNDEFINED, JS_UNDEFINED);
+    const char *str = JS_ToCString(ctx, json);
+    fprintf(stderr, "[qbun-step] step(%s) - suspending\n", str ? str : "?");
+    JS_FreeCString(ctx, str);
+    JS_FreeValue(ctx, json);
+    (void)this_val;
+    return JS_SuspendCall(ctx);
+}
+
+/* try to snapshot a suspended runtime; 0 = snapshot written, 1 = failed */
+static int qb_try_snapshot(QBRuntime *qr, const char *path)
+{
+    static const void *natives[] = { (const void *)qb_step };
+    static const JSSnapshotHost host = {
+        .natives = natives,
+        .native_count = 1,
+    };
+    size_t size = 0;
+    uint8_t *buf = JS_WriteSnapshot(qr->ctx, &size, &host, NULL, 0, 0);
+    FILE *f;
+    if (!buf) {
+        JSValue exc = JS_GetException(qr->ctx);
+        const char *msg = JS_ToCString(qr->ctx, exc);
+        fprintf(stderr, "[qbun-step] snapshot FAILED: %s\n", msg ? msg : "?");
+        JS_FreeCString(qr->ctx, msg);
+        JS_FreeValue(qr->ctx, exc);
+        return 1;
+    }
+    f = fopen(path, "wb");
+    if (!f || fwrite(buf, 1, size, f) != size || fclose(f)) {
+        perror(path);
+        js_free(qr->ctx, buf);
+        return 1;
+    }
+    fprintf(stderr, "[qbun-step] snapshot saved: %s (%zu bytes)\n", path, size);
+    js_free(qr->ctx, buf);
+    return 0;
+}
+
 #ifndef CONFIG_QBUN_LIB
 #define CONFIG_QBUN_LIB ""
 #endif
@@ -172,12 +224,28 @@ int main(int argc, char **argv)
             return 1;
     }
     free(preloads);
+    /* the workflow's step() builtin (registered after bootstrap so the
+       module can call it as a plain global) */
+    {
+        JSValue global = JS_GetGlobalObject(qr->ctx);
+        JS_SetPropertyStr(qr->ctx, global, "step",
+                          JS_NewCFunction(qr->ctx, qb_step, "step", 1));
+        JS_FreeValue(qr->ctx, global);
+    }
     if (file)
         ret = qb_run_main(qr, file);
     else
         ret = qb_run_eval(qr, eval, 1);
     if (ret < 0)
         return 1;
+    if (ret == 2) {
+        /* the workflow suspended in step(): snapshot and exit so a fresh
+           process can resume it (QBUN_STEP_SNAP sets the snapshot path) */
+        const char *snap = getenv("QBUN_STEP_SNAP");
+        if (!snap)
+            snap = "qbun-step.snap";
+        return qb_try_snapshot(qr, snap) == 0 ? 2 : 1;
+    }
     qb_run_loop(qr);
     ret = qb_runtime_exit(qr);
     fflush(stdout);
