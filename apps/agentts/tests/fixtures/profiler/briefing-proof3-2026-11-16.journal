{"event":"trap-result","runId":"briefing-proof3-2026-11-16","trapId":"briefing-proof3-2026-11-16/trap-1","ordinal":1,"result":{"ok":true,"error":"","candidates":[{"id":"2611.14196","title":"Joint Quantization and Dynamic Partitioning for Context-Aware Edge Vision Transformers","authors":"Zhu Jiaqi, Jain Prakriti, Katare Dewant, Kumar Saurabh","submitted":"2026-11-11","categories":"cs.AI","abstract":"","score":8,"topics":["architecture-attention","vision-multimodal","quantization"],"reason":"architecture-attention(1), vision-multimodal(2), quantization(1)"},{"id":"2611.11320","title":"Beyond Similarity Entropy: A Rank-Guided Data-Free Quantization Framework for Vision Transformers","authors":"Runqing Jiang, Ye Zhang, Pengpeng Yu, Zhuo Song, Changjun Li, Longguang Wang, Yulan Guo","submitted":"2026-11-10","categories":"cs.CV","abstract":"","score":8,"topics":["architecture-attention","vision-multimodal","quantization"],"reason":"architecture-attention(1), vision-multimodal(2), quantization(1)"},{"id":"2611.11890","title":"Training Vision Transformers to Focus: Emergence of Spatial Attention Head Specialization","authors":"Yuji Nozawa, Yu-Chieh Lin, Youyang Ng","submitted":"2026-11-10","categories":"cs.CV","abstract":"","score":8,"topics":["architecture-attention","vision-multimodal"],"reason":"architecture-attention(2), vision-multimodal(2)"},{"id":"2611.08669","title":"ChainFlow: Few-Step Latent Flow Matching for Speculative Decoding","authors":"Selim Aktas, Yusuf Erdem Erdem, Ahmed Zeer, Himmet Toprak Kesgin, Muzaffer Kaan Yuce, Mehmet Fatih Amasyali","submitted":"2026-11-09","categories":"cs.CL","abstract":"","score":8,"topics":["diffusion","speculative-decoding"],"reason":"diffusion(2), speculative-decoding(2)"},{"id":"2611.17797","title":"Vision-as-a-Tool: Visual Harness for Multimodal Agentic Coding","authors":"Haolin Yang, Wenshan Wu, Jin Jiang, Yu Cheng, Yan Xia, Ting Song, Yangyu Huang, Zhiliang Peng, Wenhui Wang, Hangbo Bao, Yuzhe Zhang, Wen-Da Wei, Tengchao Lv, Li Dong, Lei Cui, Furu Wei","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["vision-multimodal"],"reason":"vision-multimodal(3)"},{"id":"2611.17930","title":"Token2Tile: Token-Wise Sparse Attention with Tile Execution through a Low-Rank Space for Video DiTs","authors":"Xuecheng Wu, Aichen Feng, Jinyan Chen, Qingjie Zhao, Julien Lai","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal"],"reason":"architecture-attention(2), vision-multimodal(1)"},{"id":"2611.18057","title":"SWAM: Saliency-Weighted Asymmetric Merging for Efficient Vision Transformers","authors":"Utkarsh Kumar Singh, Manish Das, Shiv Ram Dubey, Satish Kumar Singh","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal"],"reason":"architecture-attention(1), vision-multimodal(2)"},{"id":"2611.18482","title":"MMFlash: Faster Speculative Decoding for Vision-Language Models","authors":"Sicheng Feng, Zigeng Chen, Song Wang, Gongfan Fang, Xinchao Wang","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["vision-multimodal","speculative-decoding"],"reason":"vision-multimodal(1), speculative-decoding(2)"},{"id":"2611.18549","title":"JVT: Just Video Transformer makes pixel-space video diffusion simple","authors":"Jianjun Zhou, Hua Geng, Haoyu Guo","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal","diffusion"],"reason":"architecture-attention(1), vision-multimodal(1), diffusion(1)"},{"id":"2611.16219","title":"GC-MoE on SM120: Overlapping Expert-Parallel Token Dispatch with Warp-Level FP8xFP4 Block-Scaled MMA on Consumer Blackwell","authors":"Yong Li, Haoyu Wang, Kan Liu, Tao Lan","submitted":"2026-11-13","categories":"cs.LG","abstract":"","score":6,"topics":["architecture-attention","quantization"],"reason":"architecture-attention(1), quantization(2)"},{"id":"2611.16345","title":"DRAMA: Dissecting Attention Redundancy for Accelerating Multimodal Diffusion Large Language Models","authors":"Yi-Hsin Hung, Fangfu Liu, Shao-Yuan Lo, Chu-Song Chen","submitted":"2026-11-13","categories":"cs.LG","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal","diffusion"],"reason":"architecture-attention(1), vision-multimodal(1), diffusion(1)"},{"id":"2611.16500","title":"EvenVLM: A Text and Multimodal Dataset for the Even Language with Vision-Language Fine-Tuning","authors":"Daniil Makovetskii, Ivan Bondarenko","submitted":"2026-11-13","categories":"cs.CL","abstract":"","score":6,"topics":["vision-multimodal"],"reason":"vision-multimodal(3)"},{"id":"2602.22678","title":"ViCLIP-OT: The First Foundation Vision-Language Model for Vietnamese Image-Text Retrieval with Optimal Transport","authors":"Quoc-Khang Tran, Minh-Thien Nguyen, Nguyen-Khang Pham","submitted":"2026-11-10","categories":"cs.CL","abstract":"","score":6,"topics":["context-compression","vision-multimodal"],"reason":"context-compression(1), vision-multimodal(2)"},{"id":"2611.15328","title":"Vision-Grounded Semantic Learning and Alignment for Scalable Multilingual Text-Based Person Retrieval","authors":"Xinyu Zhou, Fan Li, Shasha Chen, Min Cao, Ahtamjan Ahmat, Qiaoming Zhu, Mang Ye","submitted":"2026-11-13","categories":"cs.CL","abstract":"","score":4,"topics":["context-compression","vision-multimodal"],"reason":"context-compression(1), vision-multimodal(1)"},{"id":"2611.13017","title":"Multi-Future Drafting: Mixture Block Drafters for Tree-Verified Speculative Decoding","authors":"Haoyu Huang, Jialiang Kang, Linlin Yang, Xiao Yang, Baochang Zhang","submitted":"2026-11-11","categories":"cs.LG","abstract":"","score":6,"topics":["speculative-decoding"],"reason":"speculative-decoding(3)"},{"id":"2611.12356","title":"DForkTree: Accelerating Speculative Decoding with Fork-Aware Block Diffusion Draft Trees","authors":"Zhicheng Zheng, Cheng Zhang, Chenkai Tang, Tianxiang Zhao","submitted":"2026-11-10","categories":"cs.AI","abstract":"","score":6,"topics":["diffusion","speculative-decoding"],"reason":"diffusion(1), speculative-decoding(2)"},{"id":"2611.12956","title":"ADIndex: Layer-Adaptive Sparse Attention Indexing via Group-Level Distillation","authors":"Jin-Fei Qi, Yiduo Li, Jiang-Xin Shi, Kan Liu, Tao Lan, Hanlin Tang, Yu-Feng Li","submitted":"2026-11-11","categories":"cs.LG","abstract":"","score":6,"topics":["architecture-attention","diffusion"],"reason":"architecture-attention(2), diffusion(1)"},{"id":"2611.10448","title":"ESTRA: Enabling Extreme Attention Sparsity for Training-Free Video Diffusion Acceleration","authors":"Enhuai Liu, Yunke Wang, Yutong Wang, Changming Sun","submitted":"2026-11-10","categories":"cs.CV","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal","diffusion"],"reason":"architecture-attention(1), vision-multimodal(1), diffusion(1)"}],"excludedSeen":["2611.09239","2611.09825","2611.10649","2611.12062","2611.12127","2611.12464","2611.12634","2611.12825","2611.12832","2611.12852","2611.13378","2611.13410","2611.13545","2611.13607","2611.13675","2611.13855","2611.13885","2611.13975","2611.14221","2611.14246","2611.14387","2611.14397","2611.14399","2611.14413","2611.14459","2611.14467","2611.14469","2611.14483","2611.14515","2611.15642","2611.15671","2611.15842","2611.16265","2611.16384","2611.16426","2611.16478","2611.16502","2611.16714","2611.17108","2611.17162","2611.17194","2611.17240","2611.17287","2611.17297","2611.17309","2611.17313","2611.17320","2611.17331","2611.17334","2611.17336"],"scanned":2892,"freshCount":2842,"windowStart":"2026-11-09","windowEnd":"2026-11-16","source":"arxiv.org list pastweek","apiStatus":0,"earliestScanned":"2026-11-09"}}
