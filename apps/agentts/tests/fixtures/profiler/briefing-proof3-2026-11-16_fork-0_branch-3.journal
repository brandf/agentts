{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-3","trapId":"briefing-proof3-2026-11-16/fork-0/branch-3/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.08669","title":"ChainFlow: Few-Step Latent Flow Matching for Speculative Decoding","authors":"Selim Aktas, Yusuf Erdem Erdem, Ahmed Zeer, Himmet Toprak Kesgin, Muzaffer Kaan Yuce, Mehmet Fatih Amasyali","submitted":"2026-11-09","categories":"cs.CL","abstract":"","score":8,"topics":["diffusion","speculative-decoding"],"reason":"diffusion(2), speculative-decoding(2)"}}}}
