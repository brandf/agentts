{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-7","trapId":"briefing-proof3-2026-11-16/fork-0/branch-7/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.18482","title":"MMFlash: Faster Speculative Decoding for Vision-Language Models","authors":"Sicheng Feng, Zigeng Chen, Song Wang, Gongfan Fang, Xinchao Wang","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["vision-multimodal","speculative-decoding"],"reason":"vision-multimodal(1), speculative-decoding(2)"}}}}
