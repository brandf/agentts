{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-8","trapId":"briefing-proof3-2026-11-16/fork-0/branch-8/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.18549","title":"JVT: Just Video Transformer makes pixel-space video diffusion simple","authors":"Jianjun Zhou, Hua Geng, Haoyu Guo","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal","diffusion"],"reason":"architecture-attention(1), vision-multimodal(1), diffusion(1)"}}}}
