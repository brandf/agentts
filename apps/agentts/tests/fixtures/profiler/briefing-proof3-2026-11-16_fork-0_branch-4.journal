{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-4","trapId":"briefing-proof3-2026-11-16/fork-0/branch-4/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.17797","title":"Vision-as-a-Tool: Visual Harness for Multimodal Agentic Coding","authors":"Haolin Yang, Wenshan Wu, Jin Jiang, Yu Cheng, Yan Xia, Ting Song, Yangyu Huang, Zhiliang Peng, Wenhui Wang, Hangbo Bao, Yuzhe Zhang, Wen-Da Wei, Tengchao Lv, Li Dong, Lei Cui, Furu Wei","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["vision-multimodal"],"reason":"vision-multimodal(3)"}}}}
