{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-5","trapId":"briefing-proof3-2026-11-16/fork-0/branch-5/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.17930","title":"Token2Tile: Token-Wise Sparse Attention with Tile Execution through a Low-Rank Space for Video DiTs","authors":"Xuecheng Wu, Aichen Feng, Jinyan Chen, Qingjie Zhao, Julien Lai","submitted":"2026-11-16","categories":"cs.CV","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal"],"reason":"architecture-attention(2), vision-multimodal(1)"}}}}
