{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-2","trapId":"briefing-proof3-2026-11-16/fork-0/branch-2/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.11890","title":"Training Vision Transformers to Focus: Emergence of Spatial Attention Head Specialization","authors":"Yuji Nozawa, Yu-Chieh Lin, Youyang Ng","submitted":"2026-11-10","categories":"cs.CV","abstract":"","score":8,"topics":["architecture-attention","vision-multimodal"],"reason":"architecture-attention(2), vision-multimodal(2)"}}}}
