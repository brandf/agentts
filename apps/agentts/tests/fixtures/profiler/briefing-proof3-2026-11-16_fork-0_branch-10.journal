{"event":"trap","runId":"briefing-proof3-2026-11-16/fork-0/branch-10","trapId":"briefing-proof3-2026-11-16/fork-0/branch-10/trap-0","ordinal":0,"type":"job","arg":{"spec":"briefing-read","input":{"paper":{"id":"2611.16345","title":"DRAMA: Dissecting Attention Redundancy for Accelerating Multimodal Diffusion Large Language Models","authors":"Yi-Hsin Hung, Fangfu Liu, Shao-Yuan Lo, Chu-Song Chen","submitted":"2026-11-13","categories":"cs.LG","abstract":"","score":6,"topics":["architecture-attention","vision-multimodal","diffusion"],"reason":"architecture-attention(1), vision-multimodal(1), diffusion(1)"}}}}
